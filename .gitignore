/target
Cargo.lock.orig

# Backups galdeck-model writes beside a config file before rewriting it.
*.toml.bak

# Local-only cargo overrides -- the [patch.crates-io] that points `galdeck`
# at the checkout beside this one. Never committed: CI builds the published
# framework, and a lockfile carrying the patch fails every --locked job.
/.cargo/
